# Copia este fichero a .env.local y rellena tu clave real:
#   cp .env.local.example .env.local
#
# API key de OpenRouter (tiene modelos gratis con sufijo ":free").
# Crea una en: https://openrouter.ai/keys
# Se usa SOLO en el servidor (app/api/chat/route.ts); nunca se expone al navegador.
OPENROUTER_API_KEY=tu_api_key_aqui

# Opcional: cambia el modelo sin tocar código.
# Lista de modelos gratis: https://openrouter.ai/models?max_price=0
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
